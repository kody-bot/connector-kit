{
  "name": "@kody-bot/connector-kit",
  "version": "0.0.0-semantically-released",
  "description": "Shared protocol helpers and types for Kody remote connectors.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./urls": {
      "types": "./dist/urls.d.ts",
      "default": "./dist/urls.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run build && npm test"
  },
  "keywords": [
    "kody",
    "connector",
    "mcp",
    "protocol"
  ],
  "author": "Kent C. Dodds <me@kentcdodds.com> (https://kentcdodds.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kody-bot/connector-kit.git"
  },
  "bugs": {
    "url": "https://github.com/kody-bot/connector-kit/issues"
  },
  "homepage": "https://github.com/kody-bot/connector-kit#readme",
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "24.x"
  },
  "publishConfig": {
    "access": "public"
  }
}
